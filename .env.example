DEBUG=True
SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite by default (local + testing without Docker)
USE_SQLITE=true
DATABASE_URL=sqlite:///db.sqlite3

# Postgres (optional): docker compose up -d, then USE_SQLITE=false and:
# DATABASE_URL=postgres://erp:erp@localhost:5432/erp_dev

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ERP_MODULES=inventory,procurement,finance,crm,sales,hr,assets,construction
ERP_INDUSTRY=construction
